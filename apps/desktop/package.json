{
  "name": "@shaohui_jin/git-cockpit-desktop",
  "version": "0.1.25",
  "private": true,
  "author": "Git Cockpit",
  "description": "Git Cockpit 桌面窗壳：用本机 Node 拉起或复用 daemon，窗口加载现有 Web",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "pack:win": "node scripts/pack-win.mjs",
    "pack:local": "node scripts/pack-local.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.shaohui.git-cockpit",
    "productName": "Git Cockpit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "zip",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "shaohui-jin",
      "repo": "git-cockpit"
    },
    "forceCodeSigning": false
  }
}
