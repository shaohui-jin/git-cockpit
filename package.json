{
  "name": "git-cockpit",
  "version": "0.1.7",
  "private": true,
  "description": "Git Cockpit - 基于 MCP 的 Git 可视化操作工具（monorepo）",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm -r --parallel dev",
    "prestart": "pnpm --filter @shaohui_jin/git-cockpit-core build && pnpm --filter @shaohui_jin/git-cockpit-mcp-server build",
    "start": "pnpm --parallel --filter @shaohui_jin/git-cockpit-mcp-server --filter @shaohui_jin/git-cockpit-web start",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "lint": "eslint .",
    "clean": "pnpm -r exec tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.4"
  }
}